# Node.js dependencies
node_modules/

# SQL migration files are tracked inside supabase/.
*.sql
!supabase/**/*.sql

# Generated deployment files
dist/
dist-cloudflare/
_site/
*.zip

# Local environment and secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Operating system and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
.agents/
.claude/

# Supabase CLI local state (project ref, pooler URL, schema dumps)
supabase/.temp/
supabase/.branches/

# Local database files from the removed SQLite backend
*.sqlite
*.sqlite-shm
*.sqlite-wal
